              "id": "g1",
              "op": "and",
              "in": [
                "a",
                "b"
              ]
            },
            {
              "id": "g2",
              "op": "not",
              "in": [
                "c"
              ]
            },
            {
              "id": "g3",
              "op": "xor",
              "in": [
                "g1",
                "g2"
              ],
              "label": "G3"
            }
          ],
          "outputs": [
            {
              "from": "g3",
              "label": "$Q$"
            }
          ]
        }
      ],
      "choices": [
        {
          "id": "a",
          "md": "`if ((a && b) ^ !c)`"
        },
        {
          "id": "b",
          "md": "`if ((a || b) ^ !c)`"
        },
        {
          "id": "c",
          "md": "`if ((a && b) ^ c)`"
        },
        {
          "id": "d",
          "md": "`if ((a && b) || !c)`"
        },
        {
          "id": "e",
          "md": "`if (a && b ^ !c)`"
        }
