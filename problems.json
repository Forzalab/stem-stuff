    {
      "code": "CALC1_X2P",
      "title": "Solve for x",
      "type": "mc",
      "body": [
        {
          "type": "text",
          "md": "Solve for $x$: $$x+2=11$$"
        }
      ],
      "choices": [
        {
          "id": "a",
          "md": "$13$"
        },
        {
          "id": "b",
          "md": "$9$"
        },
        {
          "id": "c",
          "md": "$\\dfrac{11}{2}$"
        },
        {
          "id": "d",
          "md": "$-9$"
        },
        {
          "id": "e",
          "md": "$22$"
        }
      ],
      "correct": "b",
      "wrong": [
        {
          "choice": "a",
          "error": "sign",
          "hint": "QUACK. You *added* 2 to both sides. What undoes $+2$?"
        },
        {
          "choice": "c",
          "error": "op-swap",
          "hint": "QUACK. Dividing by 2 undoes $\\times 2$. Is there a $\\times$ anywhere in $x+2$?"
        },
        {
          "choice": "d",
          "error": "sign",
          "hint": "QUACK. Plug your answer into $x+2$. Do you land on $11$ or on $-7$?"
        },
        {
          "choice": "e",
          "error": "op-swap",
          "hint": "QUACK. You multiplied by 2. Where in $x+2=11$ is anything being divided?"
        }
      ]
    },
