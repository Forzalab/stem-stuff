    {
      "code": "CSCI26_Q8C",
      "title": "Contrapositive",
      "type": "text",
      "body": [
        {
          "type": "text",
          "md": "Write the contrapositive of $p \\to q$."
        }
      ],
      "how": "Type ~ for ¬ and -> for →, like: ~a -> b",
      "answer": "~q -> ~p",
      "accept": [
        "¬q → ¬p",
        "¬q -> ¬p",
        "not q -> not p"
      ],
      "wrong": [
        {
          "match": "q -> p",
          "error": "fallacy",
          "hint": "QUACK. That's the converse. Where did the two nots go?"
        },
        {
          "match": "~p -> ~q",
          "error": "fallacy",
          "hint": "QUACK. That's the inverse. Contrapositive flips AND negates. Did you flip?"
        }
      ],
      "nudge": "QUACK. Contrapositive: swap the sides, then negate both. Which side is on the left now?"
    },
