# Copy to .env (gitignored). tools/ship.sh loads it to pull the newest exam banks from the brain repo.
# GitLab personal access token, read_repository on Forzalab-bravo/brain (used only when no local brain clone is found).
BRAIN_TOKEN=
# Optional: brain repo URL (default https://gitlab.com/Forzalab-bravo/brain.git).
# BRAIN_URL=
# Optional: path to an existing brain clone (default ~/brain, then /home/claude/brain).
# BRAIN_DIR=
