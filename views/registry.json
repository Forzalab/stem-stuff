{
  "$comment": "Render v2 registry: the ONE source for the view library. Edit here, then run python3 tools/gen_views.py (writes views/library.json, views/prompt/*.md, views/checkers.json and the SCHEMA.md views block). Plan: brain projects/calc/topics/openui-render-arch-plan-2026-10-18.md (START HERE v2, Appendix v1 §16); caps and locks: refine/REFINE.md F2 F3 F4 F5 F7 F11 F19, VISUAL-FIRST. Prop shapes = the P1.1 renderer's (views-lib.js LOCAL). props: ordered (positional order), JSON Schema each; {\"x-any\": true} = any shipped component. ships: P1.1 = drawn by views.js, emitted into library.json; planned = roadmap only (table in SCHEMA.md, never in a prompt).",
  "version": "0.2.0",
  "profile": "stem",
  "root": "View",
  "base": ["View", "Head", "Text", "Doodle"],
  "layers": {
    "L0": "primitives (escape hatch): build anything when no learning component fits",
    "L1": "learning components: subject-blind, know data shapes only",
    "L2": "renderers of engine data: every value comes from an engine result"
  },
  "key_props": ["answer", "key"],
  "key_ref": "^key\\.[A-Za-z0-9_.-]+$",
  "banned_props": ["color", "colour", "size", "icon", "style", "class", "className", "bg", "background", "width", "height", "font", "theme", "variant"],
  "marks": ["cur", "done", "front", "rec", "idle", "tree", "seen", "skip", "k1", "k2", "k3"],
  "doodles": ["duck", "heart", "star", "spark"],
  "refs": {
    "given": {"stages": ["pre", "wrong", "post"], "desc": "item givens (given.m, given.v0)"},
    "fig": {"stages": ["pre", "wrong", "post"], "desc": "item figures (fig0, fig1)"},
    "wrong": {"stages": ["wrong", "post"], "desc": "the picked distractor: wrong.error tag, wrong.text"},
    "key": {"stages": ["post"], "desc": "hidden answer values (key.v1); the gate drops any key ref, or literal equal to a key value, outside post", "server_props": "Predict.answer"}
  },
  "gate": [
    {"id": "parse", "desc": "statement parses as OpenUI Lang (profile stem: no Mutation, no Action, no timers)"},
    {"id": "schema", "desc": "component exists in this library; args match its props, caps included (over a cap: drop, log too-long)"},
    {"id": "query", "desc": "Query tool exists in the engine list; runs SERVER side; the browser gets results only"},
    {"id": "checker", "desc": "domain component: its checker re-runs the engine and compares"},
    {"id": "leak", "desc": "no key ref and no literal equal to a hidden value outside post; a Reveal body is a second program"},
    {"id": "stage", "desc": "recipe allows this stage; refs allowed in this stage"},
    {"id": "marks", "desc": "every state word in nodes / edges / marks / Legend items is one of marks"},
    {"id": "one-stepper", "desc": "at most one Steps or Compare per root; one figure per Steps"},
    {"id": "copy", "desc": "no string holds a hex colour, px, an emoji, or an all-caps word over 3 letters that is no code"}
  ],
  "engines": {
    "graph": {"ships": "P0.3", "tools": ["graph.trace", "graph.maxflow", "graph.coloring", "graph.mst"]},
    "symbolic": {"ships": "P0.3", "tools": ["symbolic.simplify", "symbolic.integrate", "symbolic.derivative", "symbolic.solve", "symbolic.series_test"]},
    "numeric": {"ships": "planned", "tools": ["numeric.sample", "numeric.riemann", "numeric.partial_sums"]},
    "units": {"ships": "planned", "tools": ["units.convert", "units.dimension_check", "units.sig_figs"]},
    "vectors": {"ships": "planned", "tools": ["vectors.resolve", "vectors.triangle"]},
    "logic": {"ships": "planned", "tools": ["logic.kmap_groups", "logic.truth_table", "logic.dp_table"]},
    "stats": {"ships": "planned", "tools": ["stats.distribution", "stats.sample_stats"]},
    "sequence": {"ships": "planned", "tools": ["sequence.order", "sequence.timeline"]},
    "text": {"ships": "planned", "tools": ["text.term_cards", "text.distinction"]}
  },
  "components": {
    "View": {"layer": "L0", "kind": "layout", "ships": "P1.1", "desc": "The root: its children are painted in order, each into a slot reserved when the root arrives",
      "props": {"children": {"type": "array", "items": {"x-any": true}, "maxItems": 6}}, "required": ["children"]},
    "Head": {"layer": "L0", "kind": "layout", "ships": "P1.1", "desc": "Title and one-line subtitle of a view",
      "props": {"title": {"type": "string", "maxLength": 60}, "sub": {"type": "string", "maxLength": 140}}, "required": ["title"]},
    "Text": {"layer": "L0", "kind": "layout", "ships": "P1.1", "desc": "A paragraph; **bold** is the only emphasis",
      "props": {"text": {"type": "string", "maxLength": 400}}, "required": ["text"]},
    "Legend": {"layer": "L0", "kind": "layout", "ships": "P1.1", "desc": "Legend chips, each \"mark label\"; the sample is drawn with the figure's own class",
      "props": {"items": {"type": "array", "items": {"type": "string", "maxLength": 32}, "maxItems": 8}}, "required": ["items"]},
    "Table": {"layer": "L0", "kind": "layout", "ships": "P1.1", "desc": "A small table: header cells, then rows of cells", "cluck": {"rows": 8, "cols": 4},
      "props": {"head": {"type": "array", "items": {"type": "string", "maxLength": 24}, "maxItems": 5},
                "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string", "maxLength": 40}, "maxItems": 5}, "maxItems": 12}}, "required": ["head", "rows"]},
    "Math": {"layer": "L0", "kind": "domain", "ships": "planned", "desc": "Display TeX; an identity it states is re-checked", "checker": "symbolic.simplify",
      "props": {"tex": {"type": "string", "maxLength": 200}}, "required": ["tex"]},
    "Chips": {"layer": "L0", "kind": "layout", "ships": "planned", "desc": "A row of small chips (givens, tags)",
      "props": {"items": {"type": "array", "items": {"type": "string", "maxLength": 32}, "maxItems": 8}}, "required": ["items"]},
    "Callout": {"layer": "L1", "kind": "layout", "ships": "P1.1", "desc": "A section with a rule and a short tag (\"Where it breaks\"), never a box",
      "props": {"tag": {"type": "string", "maxLength": 24}, "text": {"type": "string", "maxLength": 400}}, "required": ["tag", "text"]},
    "Steps": {"layer": "L1", "kind": "interaction", "ships": "P1.1", "desc": "A stepper: one figure, the steps, an optional frontier row and status table; Back/Next below",
      "props": {"fig": {"$ref": "#/$defs/Graph"}, "steps": {"type": "array", "items": {"$ref": "#/$defs/Step"}, "maxItems": 8, "minItems": 1},
                "front": {"type": "string", "maxLength": 32}, "head": {"type": "array", "items": {"type": "string", "maxLength": 24}, "maxItems": 5}}, "required": ["steps"]},
    "Step": {"layer": "L1", "kind": "layout", "ships": "P1.1", "desc": "One step: caption, node marks \"A:cur B:front\", edge marks \"A-B:tree\", tags \"A:0\", edge labels [\"A-B:new\"], frontier, table rows",
      "props": {"cap": {"type": "string", "maxLength": 140}, "nodes": {"type": "string", "maxLength": 200}, "edges": {"type": "string", "maxLength": 300},
                "tags": {"type": "string", "maxLength": 200}, "labels": {"type": "array", "items": {"type": "string", "maxLength": 40}, "maxItems": 12},
                "front": {"type": "array", "items": {"type": "string", "maxLength": 8}, "maxItems": 8},
                "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string", "maxLength": 40}, "maxItems": 5}, "maxItems": 12}}, "required": ["cap"]},
    "Hints": {"layer": "L1", "kind": "interaction", "ships": "P1.1", "desc": "A hint ladder: one hint at a time",
      "props": {"hints": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 3, "minItems": 1}}, "required": ["hints"]},
    "Predict": {"layer": "L1", "kind": "interaction", "ships": "P1.1", "desc": "Pick an answer; the pick is posted with the answer ref to the server, the page never resolves or draws it",
      "props": {"tag": {"type": "string", "maxLength": 24}, "q": {"type": "string", "maxLength": 140},
                "choices": {"type": "array", "items": {"type": "string", "maxLength": 24}, "maxItems": 5, "minItems": 2},
                "struck": {"type": "array", "items": {"type": "string", "maxLength": 24}, "maxItems": 4}, "tries": {"type": "integer", "minimum": 1, "maximum": 3},
                "answer": {"type": "string", "maxLength": 48, "pattern": "^key\\.[A-Za-z0-9_.-]+$"}}, "required": ["q", "choices", "answer"]},
    "Reveal": {"layer": "L1", "kind": "interaction", "ships": "P1.1", "desc": "A visible locked row; its body arrives as a second program when the stage changes",
      "props": {"lock": {"type": "string", "maxLength": 80}, "body": {"type": "array", "items": {"x-any": true}, "maxItems": 4}}, "required": ["lock"]},
    "Answer": {"layer": "L1", "kind": "layout", "ships": "P1.1", "desc": "The boxed answer and one sentence",
      "props": {"value": {"type": "string", "maxLength": 40}, "text": {"type": "string", "maxLength": 140}}, "required": ["value"]},
    "Doodle": {"layer": "L1", "kind": "layout", "ships": "P1.1", "desc": "A small drawing when nothing else fits (visual first)",
      "props": {"kind": {"type": "string", "x-enum": "doodles"}, "text": {"type": "string", "maxLength": 80}}, "required": ["kind"]},
    "Compare": {"layer": "L1", "kind": "layout", "ships": "planned", "desc": "Two side by side, stepped together",
      "props": {"children": {"type": "array", "items": {"x-any": true}, "minItems": 2, "maxItems": 2}}, "required": ["children"]},
    "Slider": {"layer": "L1", "kind": "interaction", "ships": "planned", "desc": "Binds a $state variable",
      "props": {"value": {}, "min": {"type": "number"}, "max": {"type": "number"}, "step": {"type": "number"}, "label": {"type": "string", "maxLength": 40}}, "required": ["value", "min", "max"]},
    "Choice": {"layer": "L1", "kind": "interaction", "ships": "planned", "desc": "One question with 2-3 options (low-confidence intent)",
      "props": {"q": {"type": "string", "maxLength": 140}, "options": {"type": "array", "items": {"type": "string", "maxLength": 60}, "minItems": 2, "maxItems": 3}}, "required": ["q", "options"]},
    "Assume": {"layer": "L1", "kind": "interaction", "ships": "planned", "desc": "\"I read this as X\" chip; a tap sends a refine request",
      "props": {"text": {"type": "string", "maxLength": 80}, "alts": {"type": "array", "items": {"type": "string", "maxLength": 60}, "maxItems": 3}}, "required": ["text"]},
    "MatchQuiz": {"layer": "L1", "kind": "interaction", "ships": "planned", "desc": "Match terms to definitions", "checker": "text.term_cards",
      "props": {"pairs": {"type": "array", "items": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 2}, "maxItems": 6}}, "required": ["pairs"]},
    "ITable": {"layer": "L1", "kind": "domain", "ships": "planned", "desc": "Interactive table (kmap, truth, matrix, dp)", "checker": "logic.truth_table",
      "props": {"kind": {"type": "string", "enum": ["kmap", "truth", "matrix", "dp"]}, "spec": {}}, "required": ["kind", "spec"]},
    "Graph": {"layer": "L2", "kind": "domain", "ships": "P1.1", "desc": "A graph: nodes \"A 48 100, B 160 48\", edges \"A>B, A-C\" (> directed), column labels \"48 depth 0\", marks \"A:done u0:k1\"", "checker": "graph.trace",
      "props": {"nodes": {"type": "string", "maxLength": 600}, "edges": {"type": "string", "maxLength": 600}, "cols": {"type": "string", "maxLength": 200}, "marks": {"type": "string", "maxLength": 400}}, "required": ["nodes", "edges"]},
    "FlowNet": {"layer": "L2", "kind": "domain", "ships": "planned", "desc": "Flow network with flows and the min cut", "checker": "graph.maxflow",
      "props": {"flow": {}}, "required": ["flow"]},
    "Plot": {"layer": "L2", "kind": "domain", "ships": "planned", "desc": "Function plot from sampled points", "checker": "numeric.sample",
      "props": {"data": {}}, "required": ["data"]},
    "Riemann": {"layer": "L2", "kind": "domain", "ships": "planned", "desc": "Riemann rectangles + sum", "checker": "numeric.riemann",
      "props": {"data": {}}, "required": ["data"]},
    "FBD": {"layer": "L2", "kind": "domain", "ships": "planned", "desc": "Free-body diagram; magnitudes from the engine", "checker": "vectors.resolve",
      "props": {"data": {}}, "required": ["data"]},
    "Timeline": {"layer": "L2", "kind": "domain", "ships": "planned", "desc": "Ordered events on a line (history or motion)", "checker": "sequence.timeline",
      "props": {"data": {}}, "required": ["data"]}
  },
  "recipes": {
    "hint-line": {"desc": "one next step, nothing more", "stages": ["pre", "wrong"], "length": "S",
      "components": ["Hints"]},
    "misconception": {"desc": "where the picked idea breaks, first; then the fix", "stages": ["wrong"], "length": "S",
      "components": ["Callout", "Chips"]},
    "predict-reveal": {"desc": "ask a pick, the server marks it, the Reveal body arrives as a patch", "stages": ["pre", "wrong", "post"], "length": "S",
      "components": ["Predict", "Reveal", "Callout"]},
    "steps": {"desc": "worked steps, one at a time", "stages": ["wrong", "post"], "length": "M",
      "components": ["Steps", "Step", "Graph", "Legend", "Table"]},
    "twin-compare": {"desc": "two methods or two algorithms side by side, in sync", "stages": ["pre", "wrong", "post"], "length": "M",
      "components": ["Compare", "Steps", "Step", "Graph", "Legend"]},
    "slider-explore": {"desc": "drag a parameter, watch the verdict change", "stages": ["pre", "post"], "length": "M",
      "components": ["Slider", "Plot", "Riemann"]},
    "concept-match": {"desc": "term cards, match, distinction table", "stages": ["pre", "wrong", "post"], "length": "M",
      "components": ["Callout", "MatchQuiz", "Table"]},
    "answer-table": {"desc": "the answer + the table that proves it (post only)", "stages": ["post"], "length": "S",
      "components": ["Answer", "Table", "Chips"]}
  }
}
