{
  "id": "stem",
  "version": "0.1.0",
  "root": "View",
  "schema": {
    "$defs": {
      "View": {
        "type": "object",
        "description": "root container",
        "properties": {
          "children": {
            "type": "array"
          }
        },
        "required": [
          "children"
        ]
      },
      "Stack": {
        "type": "object",
        "description": "children in order (direction is CSS, F3)",
        "properties": {
          "children": {
            "type": "array"
          }
        },
        "required": [
          "children"
        ]
      },
      "Grid": {
        "type": "object",
        "description": "small multiples, equal cells",
        "properties": {
          "children": {
            "type": "array"
          }
        },
        "required": [
          "children"
        ]
      },
      "Card": {
        "type": "object",
        "description": "boxed group with an optional tag line",
        "properties": {
          "children": {
            "type": "array"
          },
          "tag": {
            "type": "string"
          }
        },
        "required": [
          "children"
        ]
      },
      "Text": {
        "type": "object",
        "description": "short text; inline $math$ allowed",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "Math": {
        "type": "object",
        "description": "display TeX; an identity it states is re-checked",
        "properties": {
          "tex": {
            "type": "string"
          }
        },
        "required": [
          "tex"
        ]
      },
      "Table": {
        "type": "object",
        "description": "header row + body rows; cells may be refs",
        "properties": {
          "head": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "required": [
          "head",
          "rows"
        ]
      },
      "Chips": {
        "type": "object",
        "description": "row of small chips (givens, tags)",
        "properties": {
          "items": {
            "type": "array"
          }
        },
        "required": [
          "items"
        ]
      },
      "Image": {
        "type": "object",
        "description": "bank image by ref, with alt text",
        "properties": {
          "src": {},
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "alt"
        ]
      },
      "Given": {
        "type": "object",
        "description": "one given value chip, bound to a given.* ref",
        "properties": {
          "ref": {},
          "label": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ]
      },
      "Steps": {
        "type": "object",
        "description": "ordered steps, one at a time (reveal) or as tabs",
        "properties": {
          "steps": {
            "type": "array"
          },
          "mode": {
            "type": "string",
            "enum": [
              "reveal",
              "tabs"
            ]
          }
        },
        "required": [
          "steps"
        ]
      },
      "Step": {
        "type": "object",
        "description": "one step of Steps",
        "properties": {
          "title": {
            "type": "string"
          },
          "children": {
            "type": "array"
          }
        },
        "required": [
          "title",
          "children"
        ]
      },
      "Compare": {
        "type": "object",
        "description": "side by side; sync=true steps both together",
        "properties": {
          "children": {
            "type": "array"
          },
          "sync": {
            "type": "boolean"
          }
        },
        "required": [
          "children"
        ]
      },
      "Callout": {
        "type": "object",
        "description": "highlighted box, e.g. tag \"Where it breaks\"",
        "properties": {
          "tag": {
            "type": "string"
          },
          "children": {
            "type": "array"
          }
        },
        "required": [
          "tag",
          "children"
        ]
      },
      "Reveal": {
        "type": "object",
        "description": "placeholder: a visible locked row; its body is a SECOND program the server sends when the stage changes, patch-merged in place (F4)",
        "properties": {
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ]
      },
      "Predict": {
        "type": "object",
        "description": "student types a guess; the browser POSTs it to /predict and the server marks it (answer stays server side, F5)",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {},
          "tol": {
            "type": "number"
          }
        },
        "required": [
          "question",
          "answer"
        ]
      },
      "Slider": {
        "type": "object",
        "description": "binds a $state variable",
        "properties": {
          "value": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "min",
          "max"
        ]
      },
      "Choice": {
        "type": "object",
        "description": "one question with 2-3 options (low-confidence intent)",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "question",
          "options"
        ]
      },
      "Assume": {
        "type": "object",
        "description": "\"I read this as X\" chip; tap sends a refine request",
        "properties": {
          "text": {
            "type": "string"
          },
          "alts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text"
        ]
      },
      "Doodle": {
        "type": "object",
        "description": "small drawing from our art when no real visual fits (VISUAL-FIRST)",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "duck",
              "heart"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "MatchQuiz": {
        "type": "object",
        "description": "match terms to definitions",
        "properties": {
          "pairs": {}
        },
        "required": [
          "pairs"
        ]
      },
      "Axes": {
        "type": "object",
        "description": "concept axes, each Axis a spectrum",
        "properties": {
          "axes": {
            "type": "array"
          }
        },
        "required": [
          "axes"
        ]
      },
      "Axis": {
        "type": "object",
        "description": "one axis of Axes",
        "properties": {
          "name": {
            "type": "string"
          },
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "left",
          "right"
        ]
      },
      "ITable": {
        "type": "object",
        "description": "interactive table (kmap, truth, matrix, dp)",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "kmap",
              "truth",
              "matrix",
              "dp"
            ]
          },
          "spec": {}
        },
        "required": [
          "kind",
          "spec"
        ]
      },
      "Graph": {
        "type": "object",
        "description": "draws a bank graph block (fig ref) or one stage of a trace",
        "properties": {
          "fig": {},
          "stage": {
            "type": "integer"
          }
        },
        "required": [
          "fig"
        ]
      },
      "Walk": {
        "type": "object",
        "description": "algorithm stepper: stages, frontier, distances from a trace",
        "properties": {
          "trace": {}
        },
        "required": [
          "trace"
        ]
      },
      "FlowNet": {
        "type": "object",
        "description": "flow network with flows and the min cut",
        "properties": {
          "flow": {}
        },
        "required": [
          "flow"
        ]
      },
      "Plot": {
        "type": "object",
        "description": "function plot from sampled points",
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ]
      },
      "Riemann": {
        "type": "object",
        "description": "Riemann rectangles + sum",
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ]
      },
      "FBD": {
        "type": "object",
        "description": "free-body diagram; magnitudes from the engine",
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ]
      },
      "Triangle": {
        "type": "object",
        "description": "solved triangle (sides, angles)",
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ]
      },
      "Timeline": {
        "type": "object",
        "description": "ordered events on a line (history or motion)",
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ]
      }
    }
  },
  "components": {
    "View": {
      "signature": "View(children: any[])",
      "description": "root container",
      "layer": "L0",
      "kind": "layout"
    },
    "Stack": {
      "signature": "Stack(children: any[])",
      "description": "children in order (direction is CSS, F3)",
      "layer": "L0",
      "kind": "layout"
    },
    "Grid": {
      "signature": "Grid(children: any[])",
      "description": "small multiples, equal cells",
      "layer": "L0",
      "kind": "layout"
    },
    "Card": {
      "signature": "Card(children: any[], tag?: string)",
      "description": "boxed group with an optional tag line",
      "layer": "L0",
      "kind": "layout"
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "short text; inline $math$ allowed",
      "layer": "L0",
      "kind": "layout"
    },
    "Math": {
      "signature": "Math(tex: string)",
      "description": "display TeX; an identity it states is re-checked",
      "layer": "L0",
      "kind": "domain"
    },
    "Table": {
      "signature": "Table(head: string[], rows: any[][])",
      "description": "header row + body rows; cells may be refs",
      "layer": "L0",
      "kind": "layout"
    },
    "Chips": {
      "signature": "Chips(items: any[])",
      "description": "row of small chips (givens, tags)",
      "layer": "L0",
      "kind": "layout"
    },
    "Image": {
      "signature": "Image(src: any, alt: string)",
      "description": "bank image by ref, with alt text",
      "layer": "L0",
      "kind": "layout"
    },
    "Given": {
      "signature": "Given(ref: any, label?: string)",
      "description": "one given value chip, bound to a given.* ref",
      "layer": "L1",
      "kind": "layout"
    },
    "Steps": {
      "signature": "Steps(steps: any[], mode?: \"reveal\" | \"tabs\")",
      "description": "ordered steps, one at a time (reveal) or as tabs",
      "layer": "L1",
      "kind": "layout"
    },
    "Step": {
      "signature": "Step(title: string, children: any[])",
      "description": "one step of Steps",
      "layer": "L1",
      "kind": "layout"
    },
    "Compare": {
      "signature": "Compare(children: any[], sync?: boolean)",
      "description": "side by side; sync=true steps both together",
      "layer": "L1",
      "kind": "layout"
    },
    "Callout": {
      "signature": "Callout(tag: string, children: any[])",
      "description": "highlighted box, e.g. tag \"Where it breaks\"",
      "layer": "L1",
      "kind": "layout"
    },
    "Reveal": {
      "signature": "Reveal(label: string)",
      "description": "placeholder: a visible locked row; its body is a SECOND program the server sends when the stage changes, patch-merged in place (F4)",
      "layer": "L1",
      "kind": "interaction"
    },
    "Predict": {
      "signature": "Predict(question: string, answer: any, tol?: number)",
      "description": "student types a guess; the browser POSTs it to /predict and the server marks it (answer stays server side, F5)",
      "layer": "L1",
      "kind": "interaction"
    },
    "Slider": {
      "signature": "Slider(value: any, min: number, max: number, step?: number, label?: string)",
      "description": "binds a $state variable",
      "layer": "L1",
      "kind": "interaction"
    },
    "Choice": {
      "signature": "Choice(question: string, options: string[])",
      "description": "one question with 2-3 options (low-confidence intent)",
      "layer": "L1",
      "kind": "interaction"
    },
    "Assume": {
      "signature": "Assume(text: string, alts?: string[])",
      "description": "\"I read this as X\" chip; tap sends a refine request",
      "layer": "L1",
      "kind": "interaction"
    },
    "Doodle": {
      "signature": "Doodle(kind: \"duck\" | \"heart\")",
      "description": "small drawing from our art when no real visual fits (VISUAL-FIRST)",
      "layer": "L1",
      "kind": "layout"
    },
    "MatchQuiz": {
      "signature": "MatchQuiz(pairs: any)",
      "description": "match terms to definitions",
      "layer": "L1",
      "kind": "interaction"
    },
    "Axes": {
      "signature": "Axes(axes: any[])",
      "description": "concept axes, each Axis a spectrum",
      "layer": "L1",
      "kind": "domain"
    },
    "Axis": {
      "signature": "Axis(name: string, left: string, right: string)",
      "description": "one axis of Axes",
      "layer": "L1",
      "kind": "layout"
    },
    "ITable": {
      "signature": "ITable(kind: \"kmap\" | \"truth\" | \"matrix\" | \"dp\", spec: any)",
      "description": "interactive table (kmap, truth, matrix, dp)",
      "layer": "L1",
      "kind": "domain"
    },
    "Graph": {
      "signature": "Graph(fig: any, stage?: number)",
      "description": "draws a bank graph block (fig ref) or one stage of a trace",
      "layer": "L2",
      "kind": "domain"
    },
    "Walk": {
      "signature": "Walk(trace: any)",
      "description": "algorithm stepper: stages, frontier, distances from a trace",
      "layer": "L2",
      "kind": "domain"
    },
    "FlowNet": {
      "signature": "FlowNet(flow: any)",
      "description": "flow network with flows and the min cut",
      "layer": "L2",
      "kind": "domain"
    },
    "Plot": {
      "signature": "Plot(data: any)",
      "description": "function plot from sampled points",
      "layer": "L2",
      "kind": "domain"
    },
    "Riemann": {
      "signature": "Riemann(data: any)",
      "description": "Riemann rectangles + sum",
      "layer": "L2",
      "kind": "domain"
    },
    "FBD": {
      "signature": "FBD(data: any)",
      "description": "free-body diagram; magnitudes from the engine",
      "layer": "L2",
      "kind": "domain"
    },
    "Triangle": {
      "signature": "Triangle(data: any)",
      "description": "solved triangle (sides, angles)",
      "layer": "L2",
      "kind": "domain"
    },
    "Timeline": {
      "signature": "Timeline(data: any)",
      "description": "ordered events on a line (history or motion)",
      "layer": "L2",
      "kind": "domain"
    }
  },
  "componentGroups": [
    {
      "name": "L0",
      "notes": [
        "primitives (escape hatch): build anything when no learning component fits"
      ],
      "components": [
        "View",
        "Stack",
        "Grid",
        "Card",
        "Text",
        "Math",
        "Table",
        "Chips",
        "Image"
      ]
    },
    {
      "name": "L1",
      "notes": [
        "learning components: subject-blind, know data shapes only"
      ],
      "components": [
        "Given",
        "Steps",
        "Step",
        "Compare",
        "Callout",
        "Reveal",
        "Predict",
        "Slider",
        "Choice",
        "Assume",
        "Doodle",
        "MatchQuiz",
        "Axes",
        "Axis",
        "ITable"
      ]
    },
    {
      "name": "L2",
      "notes": [
        "renderers of engine data: every value comes from a Query result or a bank ref"
      ],
      "components": [
        "Graph",
        "Walk",
        "FlowNet",
        "Plot",
        "Riemann",
        "FBD",
        "Triangle",
        "Timeline"
      ]
    }
  ]
}
