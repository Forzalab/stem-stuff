        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "duck",
              "heart",
              "star",
              "spark"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "kind"
        ]
      },
      "Graph": {
        "description": "A graph: nodes \"A 48 100, B 160 48\", edges \"A>B, A-C\" (> directed), column labels \"48 depth 0\", marks \"A:done u0:k1\"",
        "type": "object",
        "properties": {
          "nodes": {
            "type": "string",
            "maxLength": 600
          },
          "edges": {
            "type": "string",
            "maxLength": 600
          },
          "cols": {
            "type": "string",
            "maxLength": 200
          },
          "marks": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "nodes",
          "edges"
        ]
      }
