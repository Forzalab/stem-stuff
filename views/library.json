{
  "id": "stem",
  "version": "0.2.0",
  "root": "View",
  "schema": {
    "$defs": {
      "View": {
        "description": "The root: its children are painted in order, each into a slot reserved when the root arrives",
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/View"
                },
                {
                  "$ref": "#/$defs/Head"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Legend"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/Callout"
                },
                {
                  "$ref": "#/$defs/Steps"
                },
                {
                  "$ref": "#/$defs/Step"
                },
                {
                  "$ref": "#/$defs/Hints"
                },
                {
                  "$ref": "#/$defs/Predict"
                },
                {
                  "$ref": "#/$defs/Reveal"
                },
                {
                  "$ref": "#/$defs/Answer"
                },
                {
                  "$ref": "#/$defs/Doodle"
                },
                {
                  "$ref": "#/$defs/Graph"
                }
              ]
            },
            "maxItems": 6
          }
        },
        "required": [
          "children"
        ]
      },
      "Head": {
        "description": "Title and one-line subtitle of a view",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "sub": {
            "type": "string",
            "maxLength": 140
          }
        },
        "required": [
          "title"
        ]
      },
      "Text": {
        "description": "A paragraph; **bold** is the only emphasis",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "text"
        ]
      },
      "Legend": {
        "description": "Legend chips, each \"mark label\"; the sample is drawn with the figure's own class",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "maxItems": 8
          }
        },
        "required": [
          "items"
        ]
      },
      "Table": {
        "description": "A small table: header cells, then rows of cells",
        "type": "object",
        "properties": {
          "head": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "maxItems": 5
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 5
            },
            "maxItems": 12
          }
        },
        "required": [
          "head",
          "rows"
        ]
      },
      "Callout": {
        "description": "A section with a rule and a short tag (\"Where it breaks\"), never a box",
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "maxLength": 24
          },
          "text": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "tag",
          "text"
        ]
      },
      "Steps": {
        "description": "A stepper: one figure, the steps, an optional frontier row and status table; Back/Next below",
        "type": "object",
        "properties": {
          "fig": {
            "$ref": "#/$defs/Graph"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Step"
            },
            "maxItems": 8,
            "minItems": 1
          },
          "front": {
            "type": "string",
            "maxLength": 32
          },
          "head": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "maxItems": 5
          }
        },
        "required": [
          "steps"
        ]
      },
      "Step": {
        "description": "One step: caption, node marks \"A:cur B:front\", edge marks \"A-B:tree\", tags \"A:0\", edge labels [\"A-B:new\"], frontier, table rows",
        "type": "object",
        "properties": {
          "cap": {
            "type": "string",
            "maxLength": 140
          },
          "nodes": {
            "type": "string",
            "maxLength": 200
          },
          "edges": {
            "type": "string",
            "maxLength": 300
          },
          "tags": {
            "type": "string",
            "maxLength": 200
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 12
          },
          "front": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8
            },
            "maxItems": 8
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 5
            },
            "maxItems": 12
          }
        },
        "required": [
          "cap"
        ]
      },
      "Hints": {
        "description": "A hint ladder: one hint at a time",
        "type": "object",
        "properties": {
          "hints": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 3,
            "minItems": 1
          }
        },
        "required": [
          "hints"
        ]
      },
      "Predict": {
        "description": "Pick an answer; the pick is posted with the answer ref to the server, the page never resolves or draws it",
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "maxLength": 24
          },
          "q": {
            "type": "string",
            "maxLength": 140
          },
          "choices": {
            "type": "array",
