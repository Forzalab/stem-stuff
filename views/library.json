        "required": [
          "lock"
        ]
      },
      "Answer": {
        "description": "The boxed answer and one sentence",
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "maxLength": 140
          }
        },
        "required": [
          "value"
        ]
      },
      "Doodle": {
        "description": "A small drawing when nothing else fits (visual first)",
