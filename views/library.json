                  "$ref": "#/$defs/Head"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Legend"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/Callout"
                },
                {
                  "$ref": "#/$defs/Steps"
                },
                {
                  "$ref": "#/$defs/Step"
                },
                {
                  "$ref": "#/$defs/Hints"
                },
                {
                  "$ref": "#/$defs/Predict"
                },
                {
                  "$ref": "#/$defs/Reveal"
                },
                {
                  "$ref": "#/$defs/Answer"
                },
                {
                  "$ref": "#/$defs/Doodle"
