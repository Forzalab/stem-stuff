              "type": "string",
              "maxLength": 24
            },
            "maxItems": 4
          },
          "tries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "answer": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^key\\.[A-Za-z0-9_.-]+$"
          }
        },
        "required": [
          "q",
          "choices",
          "answer"
        ]
      },
      "Reveal": {
        "description": "A visible locked row; its body arrives as a second program when the stage changes",
        "type": "object",
        "properties": {
          "lock": {
            "type": "string",
            "maxLength": 80
          },
          "body": {
            "type": "array",
