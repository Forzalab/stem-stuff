{
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "python3 tools/build_and_ship/build_public.py",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(sw\\.js|version\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{server/{http_server/serve,accounts/acct,answer_grading/{expr,slips},cluck_reply_checks/{oui,views_gate,livefig}}.py,server/**/__init__.py,server/data/{prompts/**,problems.json,skills.json,banks/**},shared/openui/{registry,library}.json,SCHEMA.md}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/p/:code.json",
      "destination": "/api/index?path=/p/:code.json"
    },
    {
      "source": "/state/:code",
      "destination": "/api/index?path=/state/:code"
    },
    {
      "source": "/repair/:code",
      "destination": "/api/index?path=/repair/:code"
    },
    {
      "source": "/repair/:code/check",
      "destination": "/api/index?path=/repair/:code/check"
    },
    {
      "source": "/b/:bank.json",
      "destination": "/api/index?path=/b/:bank.json"
    },
    {
      "source": "/check",
      "destination": "/api/index?path=/check"
    },
    {
      "source": "/diagnose",
      "destination": "/api/index?path=/diagnose"
    },
    {
      "source": "/diagnose/explain",
      "destination": "/api/index?path=/diagnose/explain"
    },
    {
      "source": "/narrate",
      "destination": "/api/index?path=/narrate"
    },
    {
      "source": "/explain",
      "destination": "/api/index?path=/explain"
    },
    {
      "source": "/chat",
      "destination": "/api/index?path=/chat"
    },
    {
      "source": "/log/incident",
      "destination": "/api/index?path=/log/incident"
    },
    {
      "source": "/health",
      "destination": "/api/index?path=/health"
    },
    {
      "source": "/calc",
      "destination": "/api/index?path=/calc"
    },
    {
      "source": "/mini",
      "destination": "/api/index?path=/mini"
    }
  ]
}
