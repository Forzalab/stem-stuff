{
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "python3 tools/build_public.py",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(sw\\.js|version\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{serve.py,livefig.py,views_gate.py,oui.py,views/registry.json,views/library.json,SCHEMA.md,prompts/**,problems.json,skills.json,banks/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/p/:code.json",
      "destination": "/api/index?path=/p/:code.json"
    },
    {
      "source": "/state/:code",
      "destination": "/api/index?path=/state/:code"
    },
    {
      "source": "/b/:bank.json",
      "destination": "/api/index?path=/b/:bank.json"
    },
    {
      "source": "/check",
      "destination": "/api/index?path=/check"
    },
    {
      "source": "/narrate",
      "destination": "/api/index?path=/narrate"
    },
    {
      "source": "/explain",
      "destination": "/api/index?path=/explain"
    },
    {
      "source": "/chat",
      "destination": "/api/index?path=/chat"
    },
    {
      "source": "/log/incident",
      "destination": "/api/index?path=/log/incident"
    },
    {
      "source": "/health",
      "destination": "/api/index?path=/health"
    }
  ]
}
