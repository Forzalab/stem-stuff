+}
+const browser = await pw[process.env.PW_BROWSER || "chromium"].launch({ args: ["--no-sandbox"] });
+async function open(w, hash = "#BANK_CVT") {
+  const phone = w < 500;
+  const ctx = await browser.newContext({ viewport: { width: w, height: phone ? 852 : 800 }, hasTouch: phone && !process.env.PW_BROWSER, isMobile: phone && !process.env.PW_BROWSER, serviceWorkers: "block" });
