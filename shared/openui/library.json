      "kind": "layout",
      "props": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "maxItems": 8
          }
        },
        "required": [
          "items"
        ]
      }
    },
    "Table": {
      "signature": "Table(head: string[], rows: string[][])",
