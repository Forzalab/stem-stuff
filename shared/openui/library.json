{
  "id": "stem",
  "version": "0.2.0",
  "root": "View",
  "schema": {
    "$defs": {
      "View": {
        "description": "The root: its children are painted in order, each into a slot reserved when the root arrives",
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/View"
                },
                {
                  "$ref": "#/$defs/Head"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Legend"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/Tug"
                },
                {
                  "$ref": "#/$defs/Flip"
                },
                {
                  "$ref": "#/$defs/Callout"
                },
                {
                  "$ref": "#/$defs/Steps"
                },
                {
                  "$ref": "#/$defs/Step"
                },
                {
                  "$ref": "#/$defs/Hints"
                },
                {
                  "$ref": "#/$defs/Predict"
                },
                {
                  "$ref": "#/$defs/Reveal"
                },
                {
                  "$ref": "#/$defs/Answer"
                },
                {
                  "$ref": "#/$defs/Doodle"
                },
                {
                  "$ref": "#/$defs/Graph"
                },
                {
                  "$ref": "#/$defs/Geometry"
                }
              ]
            },
            "maxItems": 6
          }
        },
        "required": [
          "children"
        ]
      },
      "Head": {
        "description": "Title and one-line subtitle of a view",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "sub": {
            "type": "string",
            "maxLength": 140
          }
        },
        "required": [
          "title"
        ]
      },
      "Text": {
        "description": "A paragraph; **bold** is the only emphasis",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "text"
        ]
      },
      "Legend": {
        "description": "Legend chips, each \"mark label\"; the sample is drawn with the figure's own class",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "maxItems": 8
          }
        },
        "required": [
          "items"
        ]
      },
      "Table": {
        "description": "A small table: header cells, then rows of cells",
        "type": "object",
        "properties": {
          "head": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "maxItems": 5
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 5
            },
            "maxItems": 12
          }
        },
        "required": [
          "head",
          "rows"
        ]
      },
      "Tug": {
        "description": "A push-pull rope: one row per factor, \"label | move | up|down|same [size 1-9]\"; the bar pulls right (up) or left (down); size is the bar's relative length; of = the thing pulled; net is the end knot (post only)",
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 110
            },
            "maxItems": 6
          },
          "of": {
            "type": "string",
            "maxLength": 24
          },
          "alt": {
            "type": "string",
            "maxLength": 120
          },
          "net": {
            "type": "string",
            "maxLength": 24
          }
        },
        "required": [
          "rows"
        ]
      },
      "Flip": {
        "description": "Cards that flip from \"you did\" to \"the fix\": rows of [step, you did, the fix]; tap a card to flip it back",
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 3
            },
            "maxItems": 4
          },
          "alt": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "rows"
        ]
      },
      "Callout": {
        "description": "A section with a rule and a short tag (\"Where it breaks\"), never a box",
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "maxLength": 24
          },
          "text": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "tag",
          "text"
        ]
      },
      "Steps": {
        "description": "A stepper: ONE anchor figure (Graph, Geometry or Doodle) drawn once for every step, the steps, an optional frontier row and status table; pips and Show all on top, Back/Next below. A Geometry fig keeps its structure: each Step lights its parts (lit; the rest turns pale), hides parts (hide) or relabels one (say), never a new figure per step. Draw objects from seg / rect / poly / arrow / label; label each quantity once (\"R_1 = 2 Ω\", \"I = ?\") so it gets its own colour, in the figure and in the formulas. No step numbers in any text. Example, 9 V across 2 Ω and 4 Ω in a row: s = Steps(g, [a, b, c]); g = Geometry(\"A 0,0; B 0,3; C 6,3; D 6,0; E 1,2.6; F 2.6,3.4; G 3.4,2.6; H 5,3.4; J 2,2.6; K 4,3.4\", [\"seg(A,B)\", \"seg(B,C)\", \"seg(C,D)\", \"seg(D,A)\", \"rect(E,F,$R_1$ = 2 Ω,fill)\", \"rect(G,H,$R_2$ = 4 Ω,fill)\", \"rect(J,K,$R$,fill)\", \"label(A,V = 9 V)\", \"label(D,I = ?)\"]); a = Step(\"We add the two resistances: one row, one path.\", null, null, null, null, null, null, \"R = R_1 + R_2\", \"R_1 R_2\", \"Add the resistances\", \"R\"); b = Step(\"We swap both boxes for one box with that total.\", null, null, null, null, null, null, \"R = 2 + 4\", \"R\", \"One box in their place\", \"R_1 R_2\"); c = Step(\"Now you divide the push by the total.\", null, null, null, null, null, null, \"I = V / R\", \"V I\", \"Find the current\", \"R_1 R_2\", [\"I=I = V / R\"])",
        "type": "object",
        "properties": {
          "fig": {
            "anyOf": [
              {
                "$ref": "#/$defs/Graph"
              },
              {
                "$ref": "#/$defs/Geometry"
              },
              {
                "$ref": "#/$defs/Doodle"
              }
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Step"
            },
            "maxItems": 8,
            "minItems": 1
          },
          "front": {
            "type": "string",
            "maxLength": 32
          },
          "head": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "maxItems": 5
          }
        },
        "required": [
          "steps"
        ]
      },
      "Step": {
        "description": "One step: caption (one or two short sentences; with a Geometry fig the six Graph args are null: Step(\"...\", null, null, null, null, null, null, \"W = F s\", \"F s\")), tex (one formula, TeX, no $), lit (a Geometry fig's parts this step lights, space separated: a point name \"A\", a segment \"A-B\", or a label as written \"F\" / \"\\theta\" (or its symbol: \"I\" for \"I = ?\"); every symbol in tex is a lit label; empty = all lit), title (a bold heading of a few words, never a step number), hide (parts gone this step, same tokens as lit), say (labels shown with new text this step: [\"I=I = 1.5 A\"] = the label's symbol, =, the new text; a number in it is a given, never the answer), node marks \"A:cur B:front\", edge marks \"A-B:tree\", tags \"A:0\", edge labels [\"A-B:new\"], frontier, table rows",
        "type": "object",
        "properties": {
          "cap": {
            "type": "string",
            "maxLength": 140
          },
          "nodes": {
            "type": "string",
            "maxLength": 200
          },
          "edges": {
            "type": "string",
            "maxLength": 300
          },
          "tags": {
            "type": "string",
            "maxLength": 200
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 12
          },
          "front": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8
            },
            "maxItems": 8
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 5
            },
            "maxItems": 12
          },
          "tex": {
            "type": "string",
            "maxLength": 120
          },
          "lit": {
            "type": "string",
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "hide": {
            "type": "string",
            "maxLength": 120
          },
          "say": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 4
          }
        },
        "required": [
          "cap"
        ]
      },
      "Hints": {
        "description": "A hint ladder: one hint at a time",
        "type": "object",
        "properties": {
          "hints": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 3,
            "minItems": 1
          }
        },
        "required": [
          "hints"
        ]
      },
      "Predict": {
        "description": "Pick an answer; the pick is posted with the answer ref to the server, the page never resolves or draws it",
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "maxLength": 24
          },
          "q": {
            "type": "string",
            "maxLength": 140
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "maxItems": 5,
            "minItems": 2
          },
          "struck": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "maxItems": 4
          },
          "tries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "answer": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^key\\.[A-Za-z0-9_.-]+$"
          }
        },
        "required": [
          "q",
          "choices",
          "answer"
        ]
      },
      "Reveal": {
        "description": "A visible locked row; its body arrives as a second program when the stage changes",
        "type": "object",
        "properties": {
          "lock": {
            "type": "string",
            "maxLength": 80
          },
          "body": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/View"
                },
                {
                  "$ref": "#/$defs/Head"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Legend"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/Tug"
                },
                {
                  "$ref": "#/$defs/Flip"
                },
                {
                  "$ref": "#/$defs/Callout"
                },
                {
                  "$ref": "#/$defs/Steps"
                },
                {
                  "$ref": "#/$defs/Step"
                },
                {
                  "$ref": "#/$defs/Hints"
                },
                {
                  "$ref": "#/$defs/Predict"
                },
                {
                  "$ref": "#/$defs/Reveal"
                },
                {
                  "$ref": "#/$defs/Answer"
                },
                {
                  "$ref": "#/$defs/Doodle"
                },
                {
                  "$ref": "#/$defs/Graph"
                },
                {
                  "$ref": "#/$defs/Geometry"
                }
              ]
            },
            "maxItems": 4
          }
        },
        "required": [
          "lock"
        ]
      },
      "Answer": {
        "description": "The boxed answer and one sentence",
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "maxLength": 140
          }
        },
        "required": [
          "value"
        ]
      },
      "Doodle": {
        "description": "A small drawing when nothing else fits (visual first)",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "duck",
              "heart",
              "star",
              "spark"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "kind"
        ]
      },
      "Graph": {
        "description": "A graph: nodes \"A 48 100, B 160 48\", edges \"A>B, A-C\" (> directed), column labels \"48 depth 0\", marks \"A:done u0:k1\"; figure-only emphasis props layer \"A:2 B-C:3\" (1 = what the question asks, the default; 2 = given; 3 = implied or context). Never put layer 2 or 3 on tone=bad (red stays layer 1). and tone \"A:c2 B-C:bad\" (a figure palette hue: ink muted c1 c2 c3 ok bad mark)",
        "type": "object",
        "properties": {
          "nodes": {
            "type": "string",
            "maxLength": 600
          },
          "edges": {
            "type": "string",
            "maxLength": 600
          },
          "cols": {
            "type": "string",
            "maxLength": 200
          },
          "marks": {
            "type": "string",
            "maxLength": 400
          },
          "layer": {
            "type": "string",
            "maxLength": 120,
            "x-semantic": "figure"
          },
          "tone": {
            "type": "string",
            "maxLength": 120,
            "x-semantic": "figure"
          }
        },
        "required": [
          "nodes",
          "edges"
        ]
      },
      "Geometry": {
        "description": "A to-scale geometry figure: named points \"A 0,0; B 3,0; C 3,4\" (y up), marks seg(A,B) circle(O,2) right(B,A,C) dim(A,B,3 m) angle(A,B,C,$\\theta$) arrow(A,C,$F$) label(C,top) poly(A,B,C) rect(A,B) (closed shapes: poly = the points in order, rect = an axis box from two corners; either may end with a label and then fill, e.g. rect(P,Q,$R_1$ = 2 Ω,fill); a resistor, block, cube or piston is drawn from these, never a named object); at most 16 points, 16 marks, 6 labels; a number in a label is a given, never the answer; a mark may end with layer=1|2|3 (1 = what the question asks, the default; 2 = given; 3 = implied or context). Never put layer 2 or 3 on tone=bad (red stays layer 1). and tone=<ink|muted|c1|c2|c3|ok|bad|mark|sky|amber|orange|violet|pink|cyan> (figure palette hues only; an arrow with no tone gets its own hue automatically, keyed by its label, so leave tone off unless a force must be a given color; ok / bad mean right / wrong, use them only for that), e.g. arrow(A,C,$F$,tone=c1,layer=2)",
        "type": "object",
        "properties": {
          "pts": {
            "type": "string",
            "maxLength": 240
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "maxItems": 16
          },
          "alt": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "pts",
          "marks"
        ]
      }
    }
  },
  "components": {
    "View": {
      "signature": "View(children: Component[])",
      "description": "The root: its children are painted in order, each into a slot reserved when the root arrives",
      "layer": "L0",
      "kind": "layout",
      "props": {
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/View"
                },
                {
                  "$ref": "#/$defs/Head"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Legend"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/Tug"
                },
                {
                  "$ref": "#/$defs/Flip"
                },
                {
                  "$ref": "#/$defs/Callout"
                },
                {
                  "$ref": "#/$defs/Steps"
                },
                {
                  "$ref": "#/$defs/Step"
                },
                {
                  "$ref": "#/$defs/Hints"
                },
                {
                  "$ref": "#/$defs/Predict"
                },
                {
                  "$ref": "#/$defs/Reveal"
                },
                {
                  "$ref": "#/$defs/Answer"
                },
                {
                  "$ref": "#/$defs/Doodle"
                },
                {
                  "$ref": "#/$defs/Graph"
                },
                {
                  "$ref": "#/$defs/Geometry"
                }
              ]
            },
            "maxItems": 6
          }
        },
        "required": [
          "children"
        ]
      }
    },
    "Head": {
      "signature": "Head(title: string, sub?: string)",
      "description": "Title and one-line subtitle of a view",
      "layer": "L0",
      "kind": "layout",
      "props": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "sub": {
            "type": "string",
            "maxLength": 140
          }
        },
        "required": [
