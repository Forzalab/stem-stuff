        ]
      }
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "A paragraph; **bold** is the only emphasis",
      "layer": "L0",
      "kind": "layout",
      "props": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
