{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "key.schema.json",
  "title": "stem-stuff server-only key: k/<CODE>.json (never served). See SCHEMA-SPLIT.md, MC.md section 6",
  "type": "object",
  "required": ["code", "wrong"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "code": { "type": "string", "pattern": "^(CALC1|CSCI26|PHYS)_[A-Z0-9]{3,6}$" },
    "answer": { "type": "string", "minLength": 1, "description": "num/expr: math.js or \"dne\"" },
    "points": { "type": "array", "minItems": 3, "items": { "type": "number" } },
    "tol": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 },
    "correct": { "type": "string", "pattern": "^[a-z]$", "description": "mc: the correct choice id" },
    "wrong": {
      "type": "array",
      "description": "Known wrong answers. mc: one entry per distractor (choice). freeform: match (value within tol) or re (regex on typed text).",
      "items": {
        "type": "object",
        "required": ["error", "hint"],
        "additionalProperties": false,
        "properties": {
          "choice": { "type": "string", "pattern": "^[a-z]$" },
          "match": { "type": "string", "minLength": 1 },
          "re": { "type": "string", "minLength": 1 },
          "error": { "$ref": "#/$defs/error" },
          "hint": { "$ref": "#/$defs/cluck" }
        },
        "oneOf": [ { "required": ["choice"] }, { "required": ["match"] }, { "required": ["re"] } ]
      }
    },
    "nudge": { "$ref": "#/$defs/cluck", "description": "freeform: hint for a wrong answer that matches nothing (server default if absent)" }
  },
  "oneOf": [
    { "required": ["correct"], "not": { "anyOf": [ { "required": ["answer"] }, { "required": ["nudge"] } ] } },
    { "required": ["answer"], "not": { "required": ["correct"] } }
  ],
  "$defs": {
    "error": { "enum": ["sign", "op-swap", "order-ops", "arithmetic", "algebra", "off-by-factor", "units", "deg-rad",
      "chain-rule", "product-rule", "quotient-rule", "power-rule", "limit-plug", "domain", "components", "misread", "other"] },
    "cluck": { "type": "string", "pattern": "^(QUACK|Quack)\\.", "maxLength": 300, "description": "Cluck voice: starts with QUACK., one question/action, never the answer" }
  }
}
