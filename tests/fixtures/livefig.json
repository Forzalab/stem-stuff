{
 "problem": {
  "code": "LIVE_RMP",
  "type": "mc",
  "title": "Rough ramp with a push: k in numbers (live-figure fixture)",
  "body": [
   {
    "type": "text",
    "md": "A $2.5\\ \\text{kg}$ block starts at rest on a $30^\\circ$ ramp with $\\mu_k = 0.35$. A $40\\ \\text{N}$ push along the ramp moves it $1.2\\ \\text{m}$ up into a spring, which it squeezes $0.20\\ \\text{m}$ before it stops. Find the spring constant $k$."
   }
  ],
  "choices": [
   {
    "id": "a",
    "md": "$150\\ \\text{N/m}$"
   },
   {
    "id": "b",
    "md": "$375\\ \\text{N/m}$"
   },
   {
    "id": "c",
    "md": "$600\\ \\text{N/m}$"
   }
  ],
  "correct": "b",
  "wrong": [
   {
    "choice": "a",
    "error": "sign",
    "hint": "QUACK. Which way does friction point?"
   },
   {
    "choice": "c",
    "error": "off-by-factor",
    "hint": "QUACK. Is it x or x squared in spring energy?"
   }
  ],
  "saccharine": {
   "key": "Work-energy: $W_{push} - W_f - \\Delta U_g = \\tfrac12 k x^2$\n$W_{push} = 40(1.2) = 48$ J\n$W_f = 0.35(2.5)(9.8)\\cos 30^\\circ (1.2) = 8.9$ J\n$\\Delta U_g = 2.5(9.8)(1.2)\\sin 30^\\circ = 14.7$ J\n$\\tfrac12 k (0.20)^2 = 24.4$, so $k = \\boxed{375\\ \\text{N/m}}$",
   "slip": {
    "a": "Added friction instead of subtracting it.",
    "c": "Used x, not x squared."
   }
  }
 },
